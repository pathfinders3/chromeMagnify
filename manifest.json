{
  "manifest_version": 3,
  "name": "Chrome Magnify",
  "description": "마우스 커서 중심 600×400 영역을 4배 확대하는 렌즈를 표시합니다.",
  "version": "1.1.0",
  "permissions": ["tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
